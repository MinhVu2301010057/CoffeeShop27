<!DOCTYPE html>
<html>
    <head>
        <title>Coffee Shop</title>
    </head>
    <body>
    <h1>Shop Coffee</h1>
    @foreach (var product in Model)
    {
        <img width="100" src="@product.ImageUrl" />
        <h3>@product.Name</h3>
        <p>@product.Price.ToString("C")</p>
    })
    </body>
</html>